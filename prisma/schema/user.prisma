model User {
  id            String          @id @default(uuid())
  name          String          @db.VarChar(255)
  email         String          @unique
  phone         String?
  password      String?
  role          Role            @default(TENANT)
  status        UserStatus      @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bio           String?
  profilePhoto  String?
  authProvider  authProvider    @default(CREDENTIAL)
  googleId      String?         @unique
  emailVerified Boolean         @default(false)
  payment       Payment[]       @relation("TenantPayments")
  properties    Property[]      @relation("LandlordProperties")
  rentalRequest RentalRequest[] @relation("TenantRequests")
  reviews       Review[]        @relation("TenantReviews")

  @@map("users")
}
