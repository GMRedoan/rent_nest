model Payment {
  id                    String        @id @default(uuid())
  amount                Float
  status                PaymentStatus @default(PENDING)
  tenantId              String
  rentalRequestId       String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  stripePaymentIntentId String?       @unique
  stripeSessionId       String?       @unique
  bkashTrxId            String?       @unique
  merchantInvoiceNumber String?       @unique @default("")
  bkashPaymentId        String?       @unique
  paymentGateway        paymentMethod @default(Stripe)
  rentalRequest         RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  tenant                User          @relation("TenantPayments", fields: [tenantId], references: [id])

  @@map("payments")
}
