<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Successful</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f7fb; padding: 40px 15px;">

        <tr>
            <td align="center">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                        max-width: 520px;
                        background-color: #ffffff;
                        border-radius: 20px;
                        overflow: hidden;
                        box-shadow: 0 10px 35px rgba(16, 185, 129, 0.12);
                    ">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="
                                padding: 40px 30px;
                                background: linear-gradient(135deg, #059669, #10b981);
                            ">

                            <!-- Success Icon -->
                            <div style="
                                width: 72px;
                                height: 72px;
                                line-height: 72px;
                                background-color: rgba(255,255,255,0.18);
                                border-radius: 50%;
                                font-size: 34px;
                            ">
                                ✓
                            </div>

                            <h1 style="
                                margin: 18px 0 5px;
                                color: #ffffff;
                                font-size: 26px;
                                font-weight: 700;
                            ">
                                Password Reset Successful
                            </h1>

                            <p style="
                                margin: 0;
                                color: #d1fae5;
                                font-size: 14px;
                            ">
                                Your account is secure
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px;">

                            <h2 style="
                                margin: 0 0 12px;
                                font-size: 22px;
                                color: #111827;
                            ">
                                You're all set! 🎉
                            </h2>

                            <p style="
                                margin: 0 0 25px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #6b7280;
                            ">
                                Your password has been successfully changed.
                                You can now use your new password to sign in
                                to your account.
                            </p>

                            <!-- Success Message -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="
                                            background-color: #ecfdf5;
                                            border: 1px solid #a7f3d0;
                                            border-radius: 14px;
                                            padding: 25px 20px;
                                        ">

                                        <div style="
                                            width: 48px;
                                            height: 48px;
                                            line-height: 48px;
                                            margin: 0 auto 12px;
                                            background-color: #10b981;
                                            color: #ffffff;
                                            border-radius: 50%;
                                            font-size: 24px;
                                            font-weight: bold;
                                        ">
                                            ✓
                                        </div>

                                        <p style="
                                            margin: 0;
                                            color: #047857;
                                            font-size: 16px;
                                            font-weight: 700;
                                        ">
                                            Password updated successfully
                                        </p>

                                        <p style="
                                            margin: 8px 0 0;
                                            color: #6b7280;
                                            font-size: 13px;
                                        ">
                                            Your new password is now active.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <!-- Security Notice -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 25px;">
                                <tr>
                                    <td style="
                                        background-color: #fffbeb;
                                        border-left: 4px solid #f59e0b;
                                        border-radius: 10px;
                                        padding: 15px 16px;
                                        color: #92400e;
                                        font-size: 13px;
                                        line-height: 1.6;
                                    ">
                                        🔒 <strong>Didn't make this change?</strong>
                                        Please contact our support team immediately
                                        to protect your account.
                                    </td>
                                </tr>
                            </table>

                            <p style="
                                margin: 28px 0 0;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #6b7280;
                            ">
                                For your security, we recommend using a unique
                                password that you don't use on other websites.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="
                                padding: 25px 30px;
                                background-color: #f9fafb;
                                border-top: 1px solid #dcfce7;
                            ">

                            <p style="
                                margin: 0 0 8px;
                                font-size: 13px;
                                color: #9ca3af;
                            ">
                                © 2026 Your Company. All rights reserved.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                color: #b0b7c3;
                            ">
                                This is an automated message. Please don't reply
                                to this email.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>

</html>